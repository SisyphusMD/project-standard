# Per-project parameters for the vendored standard scripts. NOT vendored itself — each project
# owns this file, and it is deliberately outside the drift lock.
PROJECT_REPO_SLUG="SisyphusMD/<project>"
# The Homebrew tap wait-for-release.sh checks for this release's bottle checksums.
PROJECT_TAP_SLUG="SisyphusMD/homebrew-tap"
# Optional: take only these standard files (must include packaging/check-standard-sync.py).
# STANDARD_FILES="packaging/check-standard-sync.py packaging/changelog-section.sh"
